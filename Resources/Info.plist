<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Scribe</string>
    <key>CFBundleDisplayName</key>
    <string>Scribe</string>
    <key>CFBundleIdentifier</key>
    <string>com.scribe.app</string>
    <key>CFBundleVersion</key>
    <string>2.0.0</string>
    <key>CFBundleShortVersionString</key>
    <string>2.0.0</string>
    <key>CFBundleExecutable</key>
    <string>Scribe</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.video</string>
    <!-- NSMicrophoneUsageDescription is deliberately absent: the app captures
         system audio via ScreenCaptureKit and never opens an input device. A
         purpose string reading "we don't use this" prompted users for a
         permission the app doesn't want. -->
    <key>NSScreenCaptureUsageDescription</key>
    <string>Scribe captures system audio to generate live captions of what you hear.</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Video File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.movie</string>
                <string>public.mpeg-4</string>
                <string>public.avi</string>
                <string>com.apple.quicktime-movie</string>
                <string>org.matroska.mkv</string>
            </array>
        </dict>
    </array>
    <!-- LSEnvironment/PATH removed. Nothing in the app resolves a binary by
         PATH — ffmpeg comes from Constants.ffmpegPaths or the bundle, and tar
         is an absolute path — so it did no work, while placing the
         group-writable /opt/homebrew/bin ahead of the system directories in
         the app's environment. -->
</dict>
</plist>
